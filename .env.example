# ===== 应用环境 =====
APP_ENV=development

# ===== LLM 配置 =====
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== 数据库 =====
DATABASE_URL=sqlite:///./offerflow.db

# ===== 向量库 ChromaDB =====
CHROMA_PERSIST_PATH=./chroma_db

# ===== 默认用户 =====
DEFAULT_USER_ID=default
DEFAULT_USER_NAME=demo
DEFAULT_USER_PASSWORD=demo1234

# ===== 服务与 CORS =====
COMPOSE_PROJECT_NAME=findjob
PORT=8001
UVICORN_RELOAD=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1

# ===== JWT 配置 =====
JWT_SECRET_KEY=offerflow-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== 加密配置（BYOK）=====
ENCRYPTION_KEY=please-change-this-encryption-key-32chars
