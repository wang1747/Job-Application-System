# ============================================================
#  OfferFlow 生产环境变量模板
#  用法：cp .env.prod.example .env.prod && 编辑后填入真实值
#        所有 ??? 的项必须修改，否则启动会报错
# ============================================================

# ===== 应用环境 =====
APP_ENV=production

# ===== LLM 配置（BYOK 架构下这是服务端默认 key，用户可覆盖）=====
DEEPSEEK_API_KEY=???
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== Postgres 数据库 =====
POSTGRES_DB=offferflow
POSTGRES_USER=offferflow
# 生成强密码：openssl rand -base64 24
POSTGRES_PASSWORD=???

# ===== 默认管理员（上线后第一时间改密码 / 建议注册后删除）=====
DEFAULT_USER_ID=default
DEFAULT_USER_NAME=demo
DEFAULT_USER_PASSWORD=???

# ===== CORS / 前端域名 =====
# 改成你的真实域名（带 https）
CORS_ORIGINS=https://offferflow.example.com
FRONTEND_PORT=80
HTTPS_PORT=443

# ===== JWT 密钥（必须 32 位以上随机串）=====
# 生成：openssl rand -hex 32
JWT_SECRET_KEY=???
JWT_ALGORITHM=HS256
# token 有效期（分钟），默认 7 天
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== BYOK 加密密钥（用于加密存储用户的 API Key，必须 32 位以上）=====
# 生成：openssl rand -hex 32
# 注意：此密钥一旦设定不可更改，否则已加密的 API Key 将无法解密
ENCRYPTION_KEY=???

# ===== 提醒推送（可选，对接 n8n / 企业微信 / 钉钉）=====
REMINDER_WEBHOOK_URL=
REMINDER_CHECK_INTERVAL_MINUTES=60
REMINDER_SERVICE_TOKEN=???
